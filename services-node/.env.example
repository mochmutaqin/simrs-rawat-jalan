# Salin ke .env. Jalankan: node --env-file=.env src/server.js
TZ=Asia/Jakarta
APP_TIMEZONE=Asia/Jakarta
PORT=3001

# Harus sama dengan JWT_SECRET di backend-yii/.env
JWT_SECRET=dev-secret-ganti-di-produksi

# Token event dari Yii -> Node (sama dengan NODE_SERVICE_TOKEN di backend-yii/.env)
SERVICE_TOKEN=dev-service-token

# Koneksi read-only (user dibuat oleh database/003_readonly_user.sql atau docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simrs
DB_USER=app_readonly
DB_PASSWORD=readonly

# Node -> Yii (endpoint /internal/*), sama dengan INTERNAL_SERVICE_TOKEN di backend-yii/.env
YII_BASE_URL=http://localhost:8080
YII_SERVICE_TOKEN=dev-service-token
YII_TIMEOUT_MS=3000
YII_RETRIES=2

# Origin frontend yang boleh memanggil Node langsung (tanpa proxy Vite)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
