# Salin ke .env lalu sesuaikan. Variabel environment sistem tetap diutamakan.
APP_TIMEZONE=Asia/Jakarta

DB_HOST=localhost
DB_PORT=5432
DB_NAME=simrs
DB_USER=postgres
DB_PASSWORD=postgres
TEST_DB_NAME=simrs_test

# Harus sama dengan JWT_SECRET di services-node/.env
JWT_SECRET=dev-secret-ganti-di-produksi
JWT_TTL=3600

# Node -> Yii (endpoint /internal/*). Sama dengan YII_SERVICE_TOKEN di services-node
INTERNAL_SERVICE_TOKEN=dev-service-token
# Yii -> Node (event outbox). Sama dengan SERVICE_TOKEN di services-node
NODE_BASE_URL=http://localhost:3001
NODE_SERVICE_TOKEN=dev-service-token

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
